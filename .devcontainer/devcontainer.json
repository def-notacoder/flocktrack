{
  "name": "Flocktrack Dev",
  "dockerComposeFile": "docker-compose.yml",
  "service": "workspace",
  "runServices": ["workspace", "postgres"],
  "workspaceFolder": "/workspaces/flocktrack",
  "shutdownAction": "stopCompose",
  "remoteEnv": {
    "DATABASE_URL": "postgresql://flocktrack:flocktrack@postgres:5432/flocktrack?schema=public",
    "PORT": "3001"
  },
  "forwardPorts": [5173, 3001, 5432],
  "postCreateCommand": "npm install && npx prisma generate",
  "customizations": {
    "vscode": {
      "extensions": [
        "Prisma.prisma",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
